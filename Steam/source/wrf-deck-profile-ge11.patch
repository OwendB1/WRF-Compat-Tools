From: Local WRF compatibility work
Subject: [PATCH] ntdll: Add controlled Deck comparison inputs

Allow SMBIOS strings and Wine's synthetic SMBIOS UUID source to come from an
explicit local directory.  Also permit the Deck comparison runtime to restore
the native unsupported DMA Guard result now measured on the authentic Deck.
All behavior is inactive unless its environment control is selected; no Deck
identity value is embedded in Wine.

diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -2425,12 +2425,33 @@ static void create_smbios_processors( struct smbios_buffer *buf )
 
 #ifdef linux
 
+static const char *get_dmi_path( const char *path, char *override_path, size_t size )
+{
+    static const char dmi_prefix[] = "/sys/class/dmi/id/";
+    const char *dmi_dir = getenv( "WINE_DMI_ID_DIR" );
+    const char *name;
+    int len;
+
+    if (!dmi_dir || dmi_dir[0] != '/') return path;
+    if (!strncmp( path, dmi_prefix, sizeof(dmi_prefix) - 1 ))
+        name = path + sizeof(dmi_prefix) - 1;
+    else if (!strcmp( path, "/var/lib/dbus/machine-id" ))
+        name = "machine-id";
+    else
+        return path;
+
+    len = snprintf( override_path, size, "%s/%s", dmi_dir, name );
+    return len >= 0 && (size_t)len < size ? override_path : path;
+}
+
 static const char *get_smbios_string( const char *path, char *str, size_t size )
 {
+    char override_path[PATH_MAX];
     FILE *file;
     size_t len;
 
     str[0] = 0;
+    path = get_dmi_path( path, override_path, sizeof(override_path) );
     if (!(file = fopen(path, "r"))) return str;
 
     len = fread( str, 1, size - 1, file );
@@ -2462,9 +2483,11 @@ static GUID *get_system_uuid( GUID *uuid )
         0,10,11,12,13,14,15                     /* 0x60 */
     };
+    char override_path[PATH_MAX];
+    const char *path = get_dmi_path( "/var/lib/dbus/machine-id", override_path, sizeof(override_path) );
     int fd;
 
     memset( uuid, 0xff, sizeof(*uuid) );
-    if ((fd = open( "/var/lib/dbus/machine-id", O_RDONLY )) != -1)
+    if ((fd = open( path, O_RDONLY )) != -1)
     {
         unsigned char buf[32], *p = buf;
         if (read( fd, buf, sizeof(buf) ) == sizeof(buf))
@@ -2490,21 +2513,21 @@ static GUID *get_system_uuid( GUID *uuid )
 static const char *get_system_serial( char *str, size_t size )
 {
     get_smbios_string( "/sys/class/dmi/id/product_serial", str, size );
-    if (!str[0]) strcpy( str, "System Serial Number" );
+    if (!str[0] && !getenv( "WINE_DMI_ID_DIR" )) strcpy( str, "System Serial Number" );
     return str;
 }
 
 static const char *get_chassis_serial( char *str, size_t size )
 {
     get_smbios_string( "/sys/class/dmi/id/chassis_serial", str, size );
-    if (!str[0]) strcpy( str, "Chassis Serial Number" );
+    if (!str[0] && !getenv( "WINE_DMI_ID_DIR" )) strcpy( str, "Chassis Serial Number" );
     return str;
 }
 
 static const char *get_board_serial( char *str, size_t size, const GUID *uuid )
 {
     get_smbios_string( "/sys/class/dmi/id/board_serial", str, size );
-    if (!str[0])
+    if (!str[0] && !getenv( "WINE_DMI_ID_DIR" ))
     {
         const BYTE *p = (const BYTE *)uuid;
         snprintf( str, 33, "%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X%02X", p[0], p[1],
@@ -4359,6 +4382,7 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
         break;
 
     case SystemDmaGuardPolicyInformation: /* 202 */
+        if (getenv( "WRF_DECK_NATIVE_SECURITY" )) return STATUS_INVALID_INFO_CLASS;
         len = sizeof(BOOLEAN);
         if (size < len) ret = STATUS_INFO_LENGTH_MISMATCH;
         else if (!info) ret = STATUS_ACCESS_VIOLATION;
-- 
