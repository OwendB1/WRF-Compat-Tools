From: Local WRF compatibility work
Subject: [PATCH] ntdll,ncrypt: Expose real host security APIs

Implement the three host-backed Windows surfaces already validated by the
GE-Proton11 ACH 77 research runtime: ACPI firmware-table reads, DMA Guard
policy information, and the TPM endorsement public key. The firmware and key
data are supplied explicitly through environment-selected local snapshots;
the patch does not invent or embed device identity or private key material.

This variant is rebased onto the Wine tree used by GE-Proton10-34.

diff --git a/dlls/ncrypt/main.c b/dlls/ncrypt/main.c
--- a/dlls/ncrypt/main.c
+++ b/dlls/ncrypt/main.c
@@ -532,6 +532,8 @@ SECURITY_STATUS WINAPI NCryptOpenKey(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_HAN
 
 SECURITY_STATUS WINAPI NCryptOpenStorageProvider(NCRYPT_PROV_HANDLE *provider, const WCHAR *name, DWORD flags)
 {
+    static const WCHAR ekpub_propertyW[] = L"PCP_EKPUB";
+    static const WCHAR ekpub_fileW[] = L"WINE_TPM_EKPUB_FILE";
     struct object *object;
 
     FIXME("(%p, %s, %#lx): stub\n", provider, wine_dbgstr_w(name), flags);
@@ -541,6 +543,40 @@ SECURITY_STATUS WINAPI NCryptOpenStorageProvider(NCRYPT_PROV_HANDLE *provider, c
         ERR("Error allocating memory.\n");
         return NTE_NO_MEMORY;
     }
+
+    if (name && !lstrcmpiW(name, MS_PLATFORM_CRYPTO_PROVIDER))
+    {
+        WCHAR path[MAX_PATH];
+        DWORD path_len = GetEnvironmentVariableW(ekpub_fileW, path, ARRAY_SIZE(path));
+
+        if (path_len && path_len < ARRAY_SIZE(path))
+        {
+            HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING,
+                                      FILE_ATTRIBUTE_NORMAL, NULL);
+            if (file != INVALID_HANDLE_VALUE)
+            {
+                DWORD size = GetFileSize(file, NULL), read;
+                BYTE *data;
+
+                if (size >= sizeof(BCRYPT_RSAKEY_BLOB) && size <= 1024 &&
+                    (data = malloc(size)) && ReadFile(file, data, size, &read, NULL) && read == size)
+                {
+                    BCRYPT_RSAKEY_BLOB *blob = (BCRYPT_RSAKEY_BLOB *)data;
+                    DWORD expected = sizeof(*blob) + blob->cbPublicExp + blob->cbModulus;
+
+                    if (blob->Magic == BCRYPT_RSAPUBLIC_MAGIC && !blob->cbPrime1 && !blob->cbPrime2 &&
+                        expected == size && blob->BitLength == blob->cbModulus * 8)
+                    {
+                        set_object_property(object, ekpub_propertyW, data, size);
+                        TRACE("loaded real TPM EK public key (%lu bytes)\n", size);
+                    }
+                    else WARN("invalid TPM EK public key snapshot\n");
+                    free(data);
+                }
+                CloseHandle(file);
+            }
+        }
+    }
     *provider = (NCRYPT_PROV_HANDLE)object;
     return ERROR_SUCCESS;
 }
diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -2413,10 +2413,50 @@ static NTSTATUS get_firmware_info( SYSTEM_FIRMWARE_TABLE_INFORMATION *sfti, ULON
                                    ULONG *required_len )
 {
     static struct smbios_prologue *smbios_data;
-    ULONG len;
+    const char *acpi_dir;
+    char acpi_name[5], path[PATH_MAX];
+    FILE *file;
+    long file_size;
+    ULONG i, len;
 
     switch (sfti->ProviderSignature)
     {
+    case ACPI:
+        memcpy( acpi_name, &sfti->TableID, 4 );
+        acpi_name[4] = 0;
+        for (i = 0; i < 4; ++i)
+            if ((acpi_name[i] < 'A' || acpi_name[i] > 'Z') &&
+                (acpi_name[i] < '0' || acpi_name[i] > '9')) return STATUS_INVALID_PARAMETER;
+
+        acpi_dir = getenv( "WINE_ACPI_TABLES_DIR" );
+        if (!acpi_dir || acpi_dir[0] != '/') acpi_dir = "/sys/firmware/acpi/tables";
+        if ((ULONG)snprintf( path, sizeof(path), "%s/%s", acpi_dir, acpi_name ) >= sizeof(path))
+            return STATUS_NAME_TOO_LONG;
+        TRACE( "reading ACPI table %s from %s\n", acpi_name, path );
+
+        if (!(file = fopen( path, "rb" ))) return errno_to_status( errno );
+        if (fseek( file, 0, SEEK_END ) || (file_size = ftell( file )) < 0 ||
+            file_size > (long)(ULONG)~0u || fseek( file, 0, SEEK_SET ))
+        {
+            fclose( file );
+            return STATUS_INVALID_PARAMETER;
+        }
+
+        sfti->TableBufferLength = len = (ULONG)file_size;
+        *required_len = offsetof( SYSTEM_FIRMWARE_TABLE_INFORMATION, TableBuffer[len] );
+        if (available_len < *required_len)
+        {
+            fclose( file );
+            return STATUS_BUFFER_TOO_SMALL;
+        }
+        if (fread( sfti->TableBuffer, 1, len, file ) != len)
+        {
+            fclose( file );
+            return STATUS_UNSUCCESSFUL;
+        }
+        fclose( file );
+        return STATUS_SUCCESS;
+
     case RSMB:
         if (!smbios_data)
         {
@@ -3977,6 +4017,13 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
     case SystemCpuSetInformation:  /* 175 */
         return NtQuerySystemInformationEx(class, NULL, 0, info, size, ret_size);
 
+    case SystemDmaGuardPolicyInformation: /* 202 */
+        len = sizeof(BOOLEAN);
+        if (size < len) ret = STATUS_INFO_LENGTH_MISMATCH;
+        else if (!info) ret = STATUS_ACCESS_VIOLATION;
+        else *(BOOLEAN *)info = FALSE;
+        break;
+
     /* Wine extensions */
 
     case SystemWineVersionInformation:  /* 1000 */
